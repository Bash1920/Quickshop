# Local development only: copy to .env.local and fill in the values.
# In Vercel, connect the Neon integration using its default variable names.
# Never commit credentials or expose them through NEXT_PUBLIC_* variables.

# Required: Neon's pooled PostgreSQL URL (hostname includes -pooler).
# Keep the TLS/SSL options supplied by Neon.
DATABASE_URL=

# Optional, recommended for explicit migrations: the direct URL for the SAME
# endpoint and database (disable Connection pooling in Neon's Connect dialog).
# First-run hosting setup can derive this from the pooled DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Used only by local/CI migration helper scripts. You do not need to set this
# in Vercel; the app performs idempotent first-run table setup at runtime.
QUICKSHOP_RUN_MIGRATIONS=0

# No VERCEL_TOKEN or NEON_API_KEY is needed in the running application.
# Account authorization happens in the Vercel dashboard / Neon integration.
