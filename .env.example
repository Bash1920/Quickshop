# Local development only: copy to .env.local and fill in the values.
# In Vercel, connect the Neon integration using its default variable names.
# Never commit credentials or expose them through NEXT_PUBLIC_* variables.

# Required: Neon's pooled PostgreSQL URL (hostname includes -pooler).
# Keep the TLS/SSL options supplied by Neon.
DATABASE_URL=

# Required for Neon schema migrations: the direct URL for the SAME endpoint
# and database (disable Connection pooling in Neon's Connect dialog).
# Normal web requests never use this value.
DATABASE_URL_UNPOOLED=

# Safe default: validate the database without altering its schema.
# Set to 1 in Vercel to apply checked-in Drizzle migrations during builds.
# Use only for a new empty database or an already migration-managed database.
# Existing databases created with drizzle-kit push need a reviewed baseline first.
QUICKSHOP_RUN_MIGRATIONS=0

# No VERCEL_TOKEN or NEON_API_KEY is needed in the running application.
# Account authorization happens in the Vercel dashboard / Neon integration.
